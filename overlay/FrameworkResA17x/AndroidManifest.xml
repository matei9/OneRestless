<?xml version="1.0" encoding="utf-8"?>
<!-- targetSdkVersion 28: OMS only skips the overlayable check for pre-Q overlays
     on the system/product partitions, and framework-res declares none of these
     resources overlayable. master_prepare.sh installs it into the guest's
     /product/overlay. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="me.lineage.overlay.a17x.framework">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <overlay android:targetPackage="android" android:isStatic="true" android:priority="10" />
    <application android:hasCode="false" />
</manifest>
